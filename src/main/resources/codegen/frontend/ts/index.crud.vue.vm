<template>
  <CrudPage
    :search-config="searchConfig"
    :table-config="tableConfig"
    :form-config="formConfig"
    :load-form-data="loadFormData"
  >
#foreach($field in $fieldConfigs)
#if($field.isShowInQuery == 1 && $field.dictType && $field.dictType.trim() != "")
    <template #search-${field.fieldName}="{ formData, prop, attrs }">
      <DictSelect v-model="formData[prop]" code="$field.dictType" v-bind="attrs" />
    </template>
#end
#end
#foreach($field in $fieldConfigs)
#if($field.isShowInList == 1 && $field.dictType && $field.dictType.trim() != "")
    <template #table-cell-${field.fieldName}="{ row }">
      <DictTag :model-value="row.${field.fieldName}" code="$field.dictType" />
    </template>
#end
#end
#foreach($field in $fieldConfigs)
#if($field.isShowInForm == 1 && $field.formType.name() != "HIDDEN" && $field.dictType && $field.dictType.trim() != "")
    <template #form-${field.fieldName}="{ formData, prop, attrs }">
      <DictSelect v-model="formData[prop]" code="$field.dictType" v-bind="attrs" />
    </template>
#end
#end
  </CrudPage>
</template>

<script setup lang="ts">
import ${entityName}API from "@/api/${moduleName}/${entityKebab}";
import type {
  ${entityName}Form,
  ${entityName}Item,
  ${entityName}Query,
} from "@/api/${moduleName}/${entityKebab}";
import type {
  CrudRecord,
  CrudFormConfig,
  CrudTableConfig,
  CrudSearchConfig,
} from "@/components/Crud/types";

defineOptions({ name: "$entityName", inheritAttrs: false });

const searchConfig: CrudSearchConfig = {
  fields: [
#foreach($field in $fieldConfigs)
#if($field.isShowInQuery == 1)
    {
      prop: "$field.fieldName",
      label: "$field.fieldComment",
#if($field.dictType && $field.dictType.trim() != "")
      type: "custom",
      attrs: { clearable: true },
#elseif($field.formType.name() == "DATE" || $field.formType.name() == "DATE_TIME")
      type: "date-picker",
#if($field.queryType.name() == "BETWEEN")
      initialValue: [],
      attrs: {
        type: "daterange",
        valueFormat: "YYYY-MM-DD",
        startPlaceholder: "开始日期",
        endPlaceholder: "结束日期",
      },
#else
      attrs: { type: "date", valueFormat: "YYYY-MM-DD", clearable: true },
#end
#elseif($field.fieldType == "Integer" || $field.fieldType == "Long" || $field.fieldType == "BigDecimal")
      type: "input-number",
      attrs: { clearable: true },
#else
      type: "input",
      attrs: { clearable: true },
#end
    },
#end
#end
  ],
};

const tableConfig: CrudTableConfig<${entityName}Query, ${entityName}Item> = {
  permissionPrefix: "${moduleName}:${entityKebab}",
  table: { border: true },
  fetchData: ${entityName}API.getPage,
  deleteByIds: ${entityName}API.deleteByIds,
  toolbarActions: ["create", "delete"],
  tableTools: ["refresh", "columns", "search"],
  columns: [
    { type: "selection", width: 50 },
#foreach($field in $fieldConfigs)
#if($field.isShowInList == 1)
    { prop: "$field.fieldName", label: "$field.fieldComment", minWidth: 120 },
#end
#end
    {
      prop: "actions",
      label: "操作",
      cellType: "actions",
      actions: ["view", "edit", "delete"],
      fixed: "right",
      width: 200,
    },
  ],
};

const formConfig: CrudFormConfig<${entityName}Form> = {
  title: ({ mode }) => ({
    create: "新增$!{entityComment}",
    edit: "编辑$!{entityComment}",
    view: "查看$!{entityComment}",
  })[mode],
  dialog: { width: 560 },
  /**
   * 保存记录，更新目标使用打开表单时的主键。
   */
  submitForm(data, { mode, id }) {
    if (mode === "create") return ${entityName}API.create(data);
    if (id === undefined) throw new Error("缺少记录 ID");
    return ${entityName}API.update(String(id), data);
  },
  fields: [
#foreach($field in $fieldConfigs)
#if($field.isShowInForm == 1 && $field.formType.name() != "HIDDEN")
    {
      prop: "$field.fieldName",
      label: "$field.fieldComment",
#if($field.isRequired == 1)
      required: true,
#end
#if($field.dictType && $field.dictType.trim() != "")
      type: "custom",
#elseif($field.formType.name() == "SWITCH")
      type: "switch",
#if($field.fieldType == "Boolean")
      initialValue: true,
      attrs: { activeValue: true, inactiveValue: false },
#else
      initialValue: 1,
      attrs: { activeValue: 1, inactiveValue: 0 },
#end
#elseif($field.formType.name() == "DATE" || $field.formType.name() == "DATE_TIME")
      type: "date-picker",
#if($field.formType.name() == "DATE_TIME")
      attrs: { type: "datetime", valueFormat: "YYYY-MM-DD HH:mm:ss" },
#else
      attrs: { type: "date", valueFormat: "YYYY-MM-DD" },
#end
#elseif($field.formType.name() == "INPUT_NUMBER")
      type: "input-number",
#if($field.fieldType == "BigDecimal" || $field.fieldType == "Double")
      attrs: { precision: 2 },
#end
#elseif($field.formType.name() == "SELECT")
      type: "select",
      options: [],
#elseif($field.formType.name() == "RADIO")
      type: "radio",
      options: [],
#elseif($field.formType.name() == "CHECK_BOX")
      type: "checkbox",
      initialValue: [],
      options: [],
#else
      type: "input",
#if($field.formType.name() == "TEXT_AREA")
      attrs: { type: "textarea", rows: 3 },
#end
#end
    },
#end
#end
  ],
};

/**
 * 加载编辑和查看所需的详情。
 */
function loadFormData(row: CrudRecord): Promise<${entityName}Form> {
  const rowKey = tableConfig.rowKey ?? "id";
  return ${entityName}API.getFormData(String(row[rowKey]));
}
</script>
