<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_expense" targetNamespace="http://youlai.tech/workflow">
  <bpmn:process id="expense" name="报销审批" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="开始">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="initiator" name="发起申请" flowable:assignee="${initiator}"
                   flowable:formKey="expense_apply" flowable:skipExpression="${_SKIP_INITIATOR == true}">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flowInitiator</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="leaderApprove" name="部门主管审批" flowable:candidateGroups="DEPT_MANAGER">
      <bpmn:incoming>flowInitiator</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="amountGateway" name="报销金额？" default="flow4">
      <bpmn:incoming>flow2</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:outgoing>flow4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="managerApprove" name="总经理审批" flowable:candidateGroups="GENERAL_MANAGER">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="financeApprove" name="财务打款" flowable:candidateGroups="FINANCE">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:incoming>flow5</bpmn:incoming>
      <bpmn:outgoing>flow6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endEvent" name="结束">
      <bpmn:incoming>flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="initiator"/>
    <bpmn:sequenceFlow id="flowInitiator" sourceRef="initiator" targetRef="leaderApprove"/>
    <bpmn:sequenceFlow id="flow2" sourceRef="leaderApprove" targetRef="amountGateway"/>
    <bpmn:sequenceFlow id="flow3" name="超过5000元" sourceRef="amountGateway" targetRef="managerApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow4" name="5000元以内" sourceRef="amountGateway" targetRef="financeApprove"/>
    <bpmn:sequenceFlow id="flow5" sourceRef="managerApprove" targetRef="financeApprove"/>
    <bpmn:sequenceFlow id="flow6" sourceRef="financeApprove" targetRef="endEvent"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_expense">
    <bpmndi:BPMNPlane id="BPMNPlane_expense" bpmnElement="expense">
      <bpmndi:BPMNShape id="initiator_di" bpmnElement="initiator">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="leaderApprove_di" bpmnElement="leaderApprove">
        <dc:Bounds x="350" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="amountGateway_di" bpmnElement="amountGateway">
        <dc:Bounds x="505" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="managerApprove_di" bpmnElement="managerApprove">
        <dc:Bounds x="620" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="financeApprove_di" bpmnElement="financeApprove">
        <dc:Bounds x="760" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_di" bpmnElement="endEvent">
        <dc:Bounds x="912" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flowInitiator_di" bpmnElement="flowInitiator">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="350" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="450" y="120"/>
        <di:waypoint x="505" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="555" y="120"/>
        <di:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="530" y="145"/>
        <di:waypoint x="530" y="280"/>
        <di:waypoint x="760" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="720" y="120"/>
        <di:waypoint x="810" y="120"/>
        <di:waypoint x="810" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
        <di:waypoint x="860" y="280"/>
        <di:waypoint x="930" y="280"/>
        <di:waypoint x="930" y="138"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
