<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.boot.module.form.mapper.FormDefinitionMapper">
    <!-- 表单定义分页列表（分页列出不含 form_json/options_json 大字段，避免无效 IO） -->
    <select id="getFormDefinitionPage" resultType="com.youlai.boot.module.form.model.vo.FormDefinitionPageVO">
        SELECT
            t1.id,
            t1.form_key,
            t1.form_name,
            t1.description,
            t1.status,
            t1.version,
            t1.is_public,
            t1.category,
            t1.create_time
        FROM
            form_definition t1
        <where>
            t1.is_deleted = 0
            <if test='queryParams.keywords!=null and queryParams.keywords.trim() neq ""'>
                AND (
                    t1.form_name LIKE CONCAT('%',#{queryParams.keywords},'%')
                    OR
                    t1.form_key LIKE CONCAT('%',#{queryParams.keywords},'%')
                )
            </if>
            <if test='queryParams.status!=null'>
                AND t1.status = #{queryParams.status}
            </if>
            <if test='queryParams.category!=null and queryParams.category.trim() neq ""'>
                AND t1.category = #{queryParams.category}
            </if>
        </where>
        ORDER BY
            t1.create_time DESC
    </select>
</mapper>
